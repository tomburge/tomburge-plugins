# Normalize line endings to LF in the repo; check out as LF everywhere
* text=auto eol=lf

# Source and docs
*.md   text eol=lf diff=markdown
*.json text eol=lf
*.ts   text eol=lf diff=javascript
*.js   text eol=lf diff=javascript
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows-only scripts keep CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Lockfiles: don't show diffs
bun.lock  text eol=lf -diff linguist-generated
bun.lockb binary linguist-generated

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
